---
interface Props {
	page: {
		currentPage: number;
		lastPage: number;
		url: {
			prev?: string;
			next?: string;
			current: string;
		};
	};
	basePath: string;
}

const { page, basePath } = Astro.props;
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageUrl = (n: number) => (n === 1 ? basePath : `${basePath}${n}/`);
---

<nav class="pagination" aria-label="分页">
	{page.url.prev ? (
		<a class="pagination-link pagination-prev" href={page.url.prev}>
			‹ 上一页
		</a>
	) : (
		<span class="pagination-link pagination-prev disabled">‹ 上一页</span>
	)}

	<span class="pagination-pages">
		{pageNumbers.map((n) =>
			n === page.currentPage ? (
				<span class="pagination-link current">{n}</span>
			) : (
				<a class="pagination-link" href={pageUrl(n)}>
					{n}
				</a>
			),
		)}
	</span>

	{page.url.next ? (
		<a class="pagination-link pagination-next" href={page.url.next}>
			下一页 ›
		</a>
	) : (
		<span class="pagination-link pagination-next disabled">下一页 ›</span>
	)}
</nav>

<style>
	.pagination {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-top: 2rem;
	}

	.pagination-pages {
		display: inline-flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.pagination-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.2rem;
		padding: 0.35rem 0.6rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-xs);
		border: 2px solid var(--border);
		background: var(--bg);
		color: var(--text);
		text-decoration: none;
	}

	.pagination-link:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.pagination-link.current {
		border-color: var(--accent);
		background: var(--accent);
		color: var(--bg);
	}

	.pagination-link.disabled {
		opacity: 0.35;
		cursor: not-allowed;
	}

	.pagination-prev,
	.pagination-next {
		min-width: auto;
	}
</style>