---
import { readFileSync } from 'node:fs';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SlidePanel from './SlidePanel.astro';

const logo = readFileSync('./public/logo.svg', 'utf-8').replace(/<\?xml[^>]*\?>/, '');
const logoSize = /<svg[^>]*width="(\d+)"[^>]*height="(\d+)"/.exec(logo);
const [logoW, logoH] = logoSize ? [+logoSize[1], +logoSize[2]] : [256, 256];
const logoHtml = logo.replace('<svg', `<svg viewBox="0 0 ${logoW} ${logoH}"`);
---

<header class="site-header">
	<div class="header-inner">
		<a class="site-logo pixel-press" href="/" aria-label="余地" title="余地">
			<span set:html={logoHtml} aria-hidden="true"></span>
		</a>

		<nav class="nav-desktop">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/posts/">文章</HeaderLink>
			<HeaderLink href="/categories/">分类</HeaderLink>
			<HeaderLink href="/archives/">归档</HeaderLink>
			<HeaderLink href="/tags/">标签</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
			<HeaderLink href="/links/">友链</HeaderLink>
			<pagefind-modal-trigger compact hide-shortcut aria-label="搜索" title="搜索"></pagefind-modal-trigger>
		</nav>

		<div class="nav-mobile">
			<pagefind-modal-trigger compact hide-shortcut aria-label="搜索" title="搜索"></pagefind-modal-trigger>
			<SlidePanel label="菜单">
				<span slot="trigger" class="menu-icon" aria-hidden="true"></span>
				<div class="drawer-title">{SITE_TITLE}</div>
				<ul class="drawer-list">
					<li><a class="drawer-link" href="/">主页</a></li>
					<li><a class="drawer-link" href="/posts/">文章</a></li>
					<li><a class="drawer-link" href="/categories/">分类</a></li>
					<li><a class="drawer-link" href="/archives/">归档</a></li>
					<li><a class="drawer-link" href="/tags/">标签</a></li>
					<li><a class="drawer-link" href="/about/">关于</a></li>
					<li><a class="drawer-link" href="/links/">友链</a></li>
				</ul>
			</SlidePanel>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 2px solid var(--text);
		background: var(--bg);
	}

	.header-inner {
		max-width: var(--layout-cap);
		margin: 0 auto;
		padding: 0.9rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.site-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.site-logo :global(svg) {
		display: block;
		height: 40px;
		width: auto;
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		height: 40px;
		overflow-x: auto;
	}

	.nav-mobile {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	/* 汉堡触发器（SlidePanel 按钮，需 :global 匹配 SlidePanel 渲染的元素） */
	:global(.nav-mobile .slide-trigger) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		background: var(--bg);
		border: 2px solid var(--text);
		cursor: pointer;
	}

	:global(.menu-icon),
	:global(.menu-icon::before),
	:global(.menu-icon::after) {
		content: '';
		display: block;
		width: 20px;
		height: 3px;
		background: var(--text);
		margin: 0 auto;
	}

	:global(.menu-icon) {
		position: relative;
	}

	:global(.menu-icon::before) {
		position: absolute;
		top: -7px;
		left: 0;
	}

	:global(.menu-icon::after) {
		position: absolute;
		top: 7px;
		left: 0;
	}

	:global(.drawer-title) {
		margin: 0.9rem;
		padding: 0.45rem 0.75rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-base);
		letter-spacing: 0.1em;
		text-align: center;
		color: var(--text);
		background: var(--bg);
		border: 2px solid var(--text);
		border-bottom: 2px solid var(--text);
	}

	:global(.drawer-list) {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0;
		overflow-y: auto;
	}

	:global(.drawer-list li) {
		border-bottom: 2px dashed var(--border);
		text-align: center;
	}

	:global(.drawer-list li:last-child) {
		border-bottom: none;
	}

	:global(.drawer-link) {
		display: block;
		padding: 0.8rem 1rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-base);
		letter-spacing: 0.06em;
		color: var(--text);
		text-decoration: none;
	}

	:global(.drawer-link:hover) {
		color: var(--accent);
		background: var(--accent-soft);
	}

	/* 手机端：隐藏桌面导航，显示汉堡 */
	@media (max-width: 768px) {
	/* 断点 = --bp-mobile */
		.nav-desktop {
			display: none;
		}

		.nav-mobile {
			display: flex;
		}

		.header-inner {
			padding: 0.5rem 1rem;
		}

		.site-logo :global(svg) {
			height: 34px;
			width: auto;
		}

		:global(.nav-mobile .slide-trigger) {
			width: 36px;
			height: 36px;
		}

		.nav-mobile pagefind-modal-trigger .pf-trigger-btn {
			padding: 0.3rem;
		}
	}
</style>