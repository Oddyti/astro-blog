---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="header-inner">
		<a class="site-title pixel-press" href="/">{SITE_TITLE}</a>

		<nav class="nav-desktop">
			<HeaderLink href="/">主页</HeaderLink>
			<HeaderLink href="/posts/">文章</HeaderLink>
			<HeaderLink href="/categories/">分类</HeaderLink>
			<HeaderLink href="/archives/">归档</HeaderLink>
			<HeaderLink href="/tags/">标签</HeaderLink>
			<HeaderLink href="/about/">关于</HeaderLink>
			<HeaderLink href="/links/">友链</HeaderLink>
			<pagefind-modal-trigger compact aria-label="搜索" title="搜索 (Cmd+K)"></pagefind-modal-trigger>
		</nav>

		<div class="nav-mobile">
			<pagefind-modal-trigger compact aria-label="搜索" title="搜索 (Cmd+K)"></pagefind-modal-trigger>
			<button
				class="menu-btn pixel-press"
				type="button"
				aria-label="打开菜单"
				aria-expanded="false"
				data-menu-btn
			>
				<span class="menu-icon"></span>
			</button>
		</div>
	</div>

	<!-- 侧拉抽屉菜单 -->
	<div class="drawer-overlay" data-overlay hidden></div>
	<nav class="drawer" data-drawer aria-label="移动端菜单">
		<div class="drawer-title">{SITE_TITLE}</div>
		<ul class="drawer-list">
			<li><a class="drawer-link" href="/">主页</a></li>
			<li><a class="drawer-link" href="/posts/">文章</a></li>
			<li><a class="drawer-link" href="/categories/">分类</a></li>
			<li><a class="drawer-link" href="/archives/">归档</a></li>
			<li><a class="drawer-link" href="/tags/">标签</a></li>
			<li><a class="drawer-link" href="/about/">关于</a></li>
			<li><a class="drawer-link" href="/links/">友链</a></li>
		</ul>
	</nav>
</header>

<script>
	const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
	const drawer = document.querySelector<HTMLElement>('[data-drawer]');
	const overlay = document.querySelector<HTMLElement>('[data-overlay]');
	if (!btn || !drawer || !overlay) throw new Error('menu elements missing');

	const open = () => {
		drawer.classList.add('open');
		overlay.hidden = false;
		btn.setAttribute('aria-expanded', 'true');
		btn.setAttribute('aria-label', '关闭菜单');
		document.body.style.overflow = 'hidden';
	};
	const close = () => {
		drawer.classList.remove('open');
		overlay.hidden = true;
		btn.setAttribute('aria-expanded', 'false');
		btn.setAttribute('aria-label', '打开菜单');
		document.body.style.overflow = '';
	};

	btn.addEventListener('click', () =>
		drawer.classList.contains('open') ? close() : open(),
	);
	overlay.addEventListener('click', close);
	drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 2px solid var(--text);
		background: var(--bg);
	}

	.header-inner {
		max-width: var(--layout-cap);
		margin: 0 auto;
		padding: 0.9rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.site-title {
		font-family: var(--font-pixel);
		font-size: var(--fs-base);
		letter-spacing: 0.1em;
		color: var(--text);
		text-decoration: none;
		white-space: nowrap;
		padding: 0.45rem 0.75rem;
		border: 2px solid var(--text);
		background: var(--bg);
	}

	.site-title:hover {
		color: var(--accent);
		border-color: var(--accent);
	}

	.nav-desktop {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		overflow-x: auto;
	}

	.nav-mobile {
		display: none;
		align-items: center;
		gap: 0.25rem;
	}

	.menu-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		padding: 0;
		background: var(--bg);
		border: 2px solid var(--text);
		cursor: pointer;
	}

	.menu-icon,
	.menu-icon::before,
	.menu-icon::after {
		content: '';
		display: block;
		width: 20px;
		height: 3px;
		background: var(--text);
		margin: 0 auto;
	}

	.menu-icon {
		position: relative;
	}

	.menu-icon::before {
		position: absolute;
		top: -7px;
		left: 0;
	}

	.menu-icon::after {
		position: absolute;
		top: 7px;
		left: 0;
	}

	/* 抽屉遮罩 */
	.drawer-overlay {
		position: fixed;
		inset: 0;
		z-index: 110;
		background: rgba(16, 19, 26, 0.5);
	}

	/* 侧拉抽屉 */
	.drawer {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 120;
		width: 150px;
		max-width: 75vw;
		background: var(--bg);
		border-left: 2px solid var(--text);
		display: flex;
		flex-direction: column;
		transform: translateX(100%);
		transition: transform 0.2s steps(6);
	}

	.drawer.open {
		transform: translateX(0);
	}

	.drawer-title {
		margin: 0.9rem;
		padding: 0.45rem 0.75rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-base);
		letter-spacing: 0.1em;
		text-align: center;
		color: var(--text);
		background: var(--bg);
		border: 2px solid var(--text);
		border-bottom: 2px solid var(--text);
	}

	.drawer-list {
		list-style: none;
		margin: 0;
		padding: 0.5rem 0;
		overflow-y: auto;
	}

	.drawer-list li {
		border-bottom: 2px dashed var(--border);
		text-align: center;
	}

	.drawer-list li:last-child {
		border-bottom: none;
	}

	.drawer-link {
		display: block;
		padding: 0.8rem 1rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-base);
		letter-spacing: 0.06em;
		color: var(--text);
		text-decoration: none;
	}

	.drawer-link:hover {
		color: var(--accent);
		background: var(--accent-soft);
	}

	/* 手机端：隐藏桌面导航，显示汉堡 */
	@media (max-width: 768px) {
	/* 断点 = --bp-mobile */
		.nav-desktop {
			display: none;
		}

		.nav-mobile {
			display: flex;
		}
	}
</style>