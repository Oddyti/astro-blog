---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { AUTHOR_NAME, CATEGORIES, SITE_SUBTITLE } from '../consts';
import SocialLinks from './SocialLinks.astro';
import { categoryPath } from '../lib/paths';
import {
	getAllPosts,
	getArchive,
	getCategoryCounts,
	getTagCounts,
} from '../lib/posts';

const posts = await getAllPosts();
const archive = getArchive(posts);
const categoryCounts = getCategoryCounts(posts);
const tagCounts = getTagCounts(posts);
---

<aside class="sidebar">
	<a class="identity" href="/about/">
		<Image class="avatar pixel-avatar" src={avatar} alt="Oddyti" width={256} height={256} loading="eager" />
		<span class="name">{AUTHOR_NAME}</span>
		<span class="subtitle">{SITE_SUBTITLE}</span>
	</a>

	<SocialLinks size={30} bordered />

	<section class="widget">
		<h2 class="widget-title pixel-title">分类</h2>
		<ul class="widget-list">
			{Object.keys(CATEGORIES).map((name) => (
				<li>
					<a class="pixel-press" href={categoryPath(name)}>
						<span class="dot" style={`background: ${CATEGORIES[name].color}`} />
						<span class="label">{name}</span>
						<span class="count">{categoryCounts.get(name) ?? 0}</span>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="widget">
		<h2 class="widget-title pixel-title">标签云</h2>
		<div class="tag-cloud" data-tags={JSON.stringify(tagCounts)}></div>
	</section>

	<section class="widget">
		<h2 class="widget-title pixel-title">归档</h2>
		<ul class="widget-list">
			{archive.slice(0, 2).map(({ year, count }) => (
				<li>
					<a class="pixel-press" href={`/archives/#${year}`}>
						<span class="label">{year}</span>
						<span class="count">{count}</span>
					</a>
				</li>
			))}
		</ul>
		<a class="widget-more pixel-fill" href="/archives/">更多归档 ›</a>
	</section>
</aside>

<script>
	import cloud from 'd3-cloud';

	(() => {
		const element = document.querySelector<HTMLElement>('.tag-cloud');
		if (!element || !element.dataset.tags || element.clientWidth <= 0) {
			return;
		}
		const host = element;
		const rawTags = element.dataset.tags;

	const tags: [string, number][] = JSON.parse(rawTags);
	const width = host.clientWidth;

	const height = 280;
	const maxCount = Math.max(...tags.map(([, count]) => count));
	const MIN_SIZE = 16;
	const MAX_SIZE = 24;
	const fontSize = (count: number) =>
		MIN_SIZE + ((count - 1) / Math.max(1, maxCount - 1)) * (MAX_SIZE - MIN_SIZE);
	const palette = ['#9ed6cc', '#2c9d8f', '#f4a262', '#e9c46a', '#264653'];
	const color = (count: number) =>
		palette[
			Math.round(
				((count - 1) / Math.max(1, maxCount - 1)) * (palette.length - 1),
			)
		];

const words = tags.map(([text, count]) => ({ text, count }));

		const mulberry32 = (seed: number) => {
			let a = seed >>> 0;
			return () => {
				a |= 0;
				a = (a + 0x6d2b79f5) | 0;
				let t = Math.imul(a ^ (a >>> 15), 1 | a);
				t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
				return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
			};
		};

		cloud()
			.size([width, height])
			.words(words)
			.random(mulberry32(20260815))
			.padding(2)
		.font('Fusion Pixel, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif')
		.rotate(() => 0)
		.fontSize((d) => fontSize(d.count))
		.on('end', draw)
		.start();

	function draw(words: any[]) {
		const svgNS = 'http://www.w3.org/2000/svg';
		const svg = document.createElementNS(svgNS, 'svg');
		svg.setAttribute('width', String(width));
		svg.setAttribute('height', String(height));
		svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
		const group = document.createElementNS(svgNS, 'g');
		group.setAttribute('transform', `translate(${width / 2},${height / 2})`);
		svg.appendChild(group);

		for (const word of words) {
			const a = document.createElementNS(svgNS, 'a');
			a.setAttribute('href', `/tags/${encodeURIComponent(word.text)}/`);
			const text = document.createElementNS(svgNS, 'text');
			text.setAttribute('text-anchor', 'middle');
			text.setAttribute('transform', `translate(${word.x},${word.y})`);
			text.setAttribute('font-size', `${word.size}px`);
			text.setAttribute(
				'font-family',
				'"Fusion Pixel", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif',
			);
			text.setAttribute('style', `fill: ${color(word.count)}`);
			text.textContent = word.text;
			a.appendChild(text);
			group.appendChild(a);
		}
		host.appendChild(svg);
		}
	})();
</script>

<style>
	.identity {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
		padding: 0.75rem 0 1rem;
		text-align: center;
		color: var(--text);
		text-decoration: none;
	}

	.identity:hover {
		color: var(--text);
	}

	.avatar {
		width: 96px;
		height: 96px;
	}

	.name {
		margin-top: 0.4rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-lg);
		letter-spacing: 0.18em;
		text-indent: 0.18em;
	}

	.subtitle {
		font-size: var(--fs-md);
		color: var(--text-soft);
		line-height: 1.6;
	}

	.widget {
		padding: 1.1rem 0 0.2rem;
		border-bottom: 2px dashed var(--border);
	}

	.widget:last-of-type {
		border-bottom: none;
	}

	.widget-title {
		margin-bottom: 0.7rem;
		font-size: var(--fs-lg);
	}

	.widget-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.widget-list a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.32rem 0.3rem;
		color: var(--text);
		text-decoration: none;
		border: 2px solid transparent;
	}

	.widget-list a:hover {
		color: var(--accent);
		
		background: var(--accent-soft);
		border-color: var(--accent);
	}

	.widget-list .label {
		flex: 1;
	}

	.widget-list .count {
		font-family: var(--font-pixel);
		font-size: var(--fs-xs);
		color: var(--text-soft);
		font-variant-numeric: tabular-nums;
	}

	.widget-more {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.25rem 0.45rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-xs);
		text-decoration: none;
	}

	.dot {
		width: 9px;
		height: 9px;
		border-radius: 0;
		flex-shrink: 0;
	}

	.tag-cloud {
		height: 280px;
	}

	.tag-cloud svg {
		display: block;
		width: 100%;
		height: auto;
	}

	.tag-cloud :global(a text) {
		cursor: pointer;
		transition: filter 0.06s steps(2);
	}

	.tag-cloud :global(a:hover text) {
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 3px;
	}
</style>