---
import type { Post } from '../lib/posts';
import { filterCategories, filterTags } from '../lib/posts';
import { categoryPath, postPath, tagPath } from '../lib/paths';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 ? (
		<ul class="post-list">
			{
				posts.map((post) => {
					const categories = filterCategories(post.data.categories);
					const tags = filterTags(post.data.tags);
					return (
						<li>
							<div class="post-card">
								<span class="post-card-date">
									<FormattedDate date={post.data.date} />
								</span>
								<a class="post-card-title" href={postPath(post)}>
									{post.data.title}
								</a>
								{(categories.length > 0 || tags.length > 0) && (
									<div class="post-card-meta">
										{categories.map((cat) => (
											<a class="chip chip-cat" href={categoryPath(cat)}>
												{cat}
											</a>
										))}
										{tags.map((tag) => (
											<a class="chip chip-tag" href={tagPath(tag)}>
												#{tag}
											</a>
										))}
									</div>
								)}
							</div>
						</li>
					);
				})
			}
		</ul>
	) : (
		<p class="empty">还没有文章。</p>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.post-list li {
		margin: 0;
	}

	/* 文章卡片：标题/分类/标签/时间，全站统一由本类控制。
	   标题→文章页，分类→分类页，标签→标签页 */
	.post-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: var(--card-pad);
		border: 2px solid var(--border);
		background: var(--bg);
		color: var(--text);
	}

	.post-card:hover {
		border-color: var(--accent);
	}

	.post-card-date {
		font-family: var(--font-pixel);
		font-size: var(--fs-md);
		letter-spacing: 0.04em;
		color: var(--text-soft);
	}

	.post-card-title {
		margin: 0;
		font-family: var(--font-pixel);
		font-size: var(--fs-lg);
		font-weight: 500;
		letter-spacing: 0.04em;
		line-height: 1.6;
		color: var(--text);
		text-decoration: none;
	}

	.post-card-title:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.1rem;
	}

	.empty {
		color: var(--text-soft);
	}

	/* 手机端：分类/标签挤在一行，溢出的标签自动隐藏（只显示放得下的） */
	@media (max-width: 768px) { /* 断点 = --bp-mobile */
		.post-card-meta {
			flex-wrap: nowrap;
			overflow: hidden;
			max-height: 1.8em;
		}

		.chip {
			flex-shrink: 0;
		}
	}
</style>