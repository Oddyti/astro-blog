---
import { CATEGORIES, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath } from '../../lib/paths';
import { filterCategories, getAllPosts } from '../../lib/posts';

const posts = await getAllPosts();

const counts = new Map<string, number>();
for (const post of posts) {
	for (const cat of filterCategories(post.data.categories)) {
		counts.set(cat, (counts.get(cat) ?? 0) + 1);
	}
}

const names = Object.keys(CATEGORIES).filter((name) => counts.has(name));
if (names.length === 0) names.push(...Object.keys(CATEGORIES));
---

<BaseLayout title={`分类 | ${SITE_TITLE}`} description="好不容易分门别类">
	<h1 class="page-title">分类</h1>
	<ul class="cat-cards">
		{
			names.map((name) => {
				const meta = CATEGORIES[name];
				return (
					<li
						class="cat-card pixel-press"
						style={`--cat-color: ${meta?.color ?? 'var(--accent)'}`}
					>
						<a href={categoryPath(name)}>
							<span class="cat-name">{name}</span>
							<span class="cat-count">{counts.get(name) ?? 0} 篇</span>
							<span class="cat-desc">{meta?.description ?? ''}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</BaseLayout>

