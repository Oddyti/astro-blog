---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import FormattedDate from '../../components/FormattedDate.astro';
import Toc from '../../components/Toc.astro';
import { LICENSE_TEXT } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath, postSlug, tagPath } from '../../lib/paths';
import { filterCategories, filterTags, getAllPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: { slug: postSlug(post) },
		props: post,
	}));
}

type Props = CollectionEntry<'post'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 2);

const categories = filterCategories(post.data.categories);
const tags = filterTags(post.data.tags);
const showLicense = post.data.license !== false;
---

<BaseLayout title={post.data.title} description={post.data.description} rail>
	<article class="post">
		<header class="post-header">
			{post.data.image && (
				<div class="cover">
					<Image src={post.data.image} alt="" width={1400} />
				</div>
			)}
			<h1 class="post-title">{post.data.title}</h1>
			<div class="post-meta">
				<span class="date">
					<FormattedDate date={post.data.date} />
				</span>
				{categories.map((cat) => (
					<a class="chip chip-cat" href={categoryPath(cat)}>
						{cat}
					</a>
				))}
				{tags.map((tag) => (
					<a class="chip chip-tag" href={tagPath(tag)}>
						#{tag}
					</a>
				))}
			</div>
		</header>

		<div class="prose">
			<Content />
		</div>

		{showLicense && <p class="license">{LICENSE_TEXT}</p>}
	</article>

	<div slot="rail">
		<Toc headings={tocHeadings} />
	</div>
</BaseLayout>

{tocHeadings.length > 0 && (
	<>
		<button class="toc-fab pixel-press" type="button" data-toc-fab aria-label="打开目录" aria-expanded="false">
			<svg viewBox="0 0 24 24" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
				<rect x="2" y="3" width="4" height="4" />
				<rect x="9" y="3" width="13" height="2" />
				<rect x="9" y="5" width="13" height="2" />
				<rect x="2" y="10" width="4" height="4" />
				<rect x="9" y="10" width="13" height="2" />
				<rect x="9" y="12" width="13" height="2" />
				<rect x="2" y="17" width="4" height="4" />
				<rect x="9" y="17" width="13" height="2" />
				<rect x="9" y="19" width="13" height="2" />
			</svg>
		</button>
		<div class="toc-overlay" data-toc-overlay hidden></div>
		<aside class="toc-panel" data-toc-panel aria-label="移动端目录">
			<div class="toc-panel-head">
				<span class="toc-panel-title">目录</span>
			</div>
			<Toc headings={tocHeadings} mobile />
		</aside>
	</>
)}

<script>
	const fab = document.querySelector<HTMLButtonElement>('[data-toc-fab]');
	const panel = document.querySelector<HTMLElement>('[data-toc-panel]');
	const overlay = document.querySelector<HTMLElement>('[data-toc-overlay]');
	if (fab && panel && overlay) {
		const open = () => {
			panel.classList.add('open');
			overlay.hidden = false;
			fab.setAttribute('aria-expanded', 'true');
			document.body.style.overflow = 'hidden';
		};
		const close = () => {
			panel.classList.remove('open');
			overlay.hidden = true;
			fab.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
		};
		fab.addEventListener('click', () =>
			panel.classList.contains('open') ? close() : open(),
		);
		overlay.addEventListener('click', close);
		panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
	}
</script>

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.cover {
		margin-bottom: 1.5rem;
	}

	.cover img {
		display: block;
		margin: 0 auto;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 70vh;
		border: 2px solid var(--text);
	}

	.post-title {
		margin: 0 0 0.6rem;
		font-size: var(--fs-2xl);
		border-bottom: none;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-md);
		color: var(--text-soft);
	}

	.post-meta .date {
		margin-right: 0.25rem;
	}

	.prose {
		overflow-wrap: break-word;
	}

	.license {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 2px dashed var(--border);
		font-family: var(--font-pixel);
		font-size: var(--fs-xs);
		color: var(--text-soft);
		letter-spacing: 0.06em;
	}

	/* 移动端浮动目录按钮 + 侧滑面板 */
	.toc-fab {
		position: fixed;
		right: 1rem;
		bottom: 1.5rem;
		z-index: 90;
		width: 48px;
		height: 48px;
		padding: 0;
		align-items: center;
		justify-content: center;
		color: var(--bg);
		background: var(--accent);
		border: 2px solid var(--text);
		opacity: 0.8;
		cursor: pointer;
		display: none;
	}

	.toc-fab:hover {
		opacity: 1;
	}

	.toc-fab svg {
		width: 26px;
		height: 26px;
		display: block;
	}

	.toc-overlay {
		position: fixed;
		inset: 0;
		z-index: 110;
		background: rgba(16, 19, 26, 0.5);
	}

	.toc-panel {
		position: fixed;
		top: 0;
		right: 0;
		bottom: 0;
		z-index: 120;
		width: 240px;
		max-width: 80vw;
		background: var(--bg);
		border-left: 2px solid var(--text);
		flex-direction: column;
		transform: translateX(100%);
		transition: transform 0.2s steps(6);
		display: none;
	}

	.toc-panel.open {
		transform: translateX(0);
	}

	.toc-panel-head {
		padding: 0.9rem 1rem;
		border-bottom: 2px solid var(--text);
		background: var(--bg-soft);
		text-align: center;
	}

	.toc-panel-title {
		font-family: var(--font-pixel);
		font-size: var(--fs-md);
		letter-spacing: 0.1em;
		color: var(--text);
	}

	.toc-panel :global(.toc--mobile) {
		padding: 1rem;
		overflow-y: auto;
	}

	@media (max-width: 768px) { /* 断点 = --bp-mobile */
		.toc-fab,
		.toc-panel {
			display: flex;
		}
	}
</style>