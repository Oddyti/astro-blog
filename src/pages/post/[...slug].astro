---
import { Image } from 'astro:assets';
import { type CollectionEntry, render } from 'astro:content';
import 'katex/dist/katex.min.css';
import FormattedDate from '../../components/FormattedDate.astro';
import SlidePanel from '../../components/SlidePanel.astro';
import Toc from '../../components/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryPath, postSlug, tagPath } from '../../lib/paths';
import { filterCategories, filterTags, getAllPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getAllPosts();
	return posts.map((post) => ({
		params: { slug: postSlug(post) },
		props: post,
	}));
}

type Props = CollectionEntry<'post'>;

const post = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth >= 2);

const categories = filterCategories(post.data.categories);
const tags = filterTags(post.data.tags);
---

<BaseLayout title={post.data.title} description={post.data.description} rail>
	<article class="post">
		<header class="post-header">
			{post.data.image && (
				<div class="cover">
					<Image src={post.data.image} alt="" width={1400} loading="eager" />
				</div>
			)}
			<h1 class="post-title">{post.data.title}</h1>
			<div class="post-meta">
				<span class="date">
					<FormattedDate date={post.data.date} />
				</span>
				{categories.map((cat) => (
					<a class="chip chip-cat" href={categoryPath(cat)}>
						{cat}
					</a>
				))}
				{tags.map((tag) => (
					<a class="chip chip-tag" href={tagPath(tag)}>
						#{tag}
					</a>
				))}
			</div>
		</header>

		<div class="prose">
			<Content />
		</div>
	</article>

	<div slot="rail">
		<Toc headings={tocHeadings} />
	</div>
</BaseLayout>

{tocHeadings.length > 0 && (
	<SlidePanel label="目录" class="toc-fab">
		<span slot="trigger">
			<svg viewBox="0 0 24 24" shape-rendering="crispEdges" fill="currentColor" aria-hidden="true">
				<rect x="2" y="3" width="4" height="4" />
				<rect x="9" y="3" width="13" height="2" />
				<rect x="9" y="5" width="13" height="2" />
				<rect x="2" y="10" width="4" height="4" />
				<rect x="9" y="10" width="13" height="2" />
				<rect x="9" y="12" width="13" height="2" />
				<rect x="2" y="17" width="4" height="4" />
				<rect x="9" y="17" width="13" height="2" />
				<rect x="9" y="19" width="13" height="2" />
			</svg>
		</span>
		<div class="toc-panel-head">
			<span class="toc-panel-title">目录</span>
		</div>
		<Toc headings={tocHeadings} mobile />
	</SlidePanel>
)}

<style>
	.post-header {
		margin-bottom: 2rem;
	}

	.cover {
		margin-bottom: 1.5rem;
	}

	/* 封面同样不加描边，与正文图片保持一致 */
	.cover img {
		display: block;
		margin: 0 auto;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 70vh;
	}

	.post-title {
		margin: 0 0 0.6rem;
		font-size: var(--fs-2xl);
		border-bottom: none;
	}

	.post-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		font-family: var(--font-pixel);
		font-size: var(--fs-md);
		color: var(--text-soft);
	}

	.post-meta .date {
		margin-right: 0.25rem;
	}

	/* 移动端浮动目录按钮（SlidePanel 触发按钮）+ 侧滑面板内容 */
	:global(.toc-fab) {
		position: fixed;
		right: 1rem;
		bottom: 1.5rem;
		z-index: 90;
		width: 48px;
		height: 48px;
		padding: 0;
		align-items: center;
		justify-content: center;
		color: var(--bg);
		background: var(--accent);
		border: 2px solid var(--text);
		opacity: 0.8;
		cursor: pointer;
		display: none;
	}

	:global(.toc-fab:hover) {
		opacity: 1;
	}

	:global(.toc-fab svg) {
		width: 26px;
		height: 26px;
		display: block;
	}

	:global(.toc-panel-head) {
		padding: 0.9rem 1rem;
		border-bottom: 2px solid var(--text);
		background: var(--bg-soft);
		text-align: center;
	}

	:global(.toc-panel-title) {
		font-family: var(--font-pixel);
		font-size: var(--fs-md);
		letter-spacing: 0.1em;
		color: var(--text);
	}

	:global(.toc-panel .toc--mobile) {
		padding: 1rem;
		overflow-y: auto;
	}

	/* 目录面板复用 SlidePanel 的 .slide-panel */
	:global(.slide-panel) {
		width: 240px;
	}

	@media (max-width: 768px) { /* 断点 = --bp-mobile */
		:global(.toc-fab) {
			display: flex;
		}
	}
</style>