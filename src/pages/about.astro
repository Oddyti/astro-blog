---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { AUTHOR_NAME, SITE_SUBTITLE, SITE_TITLE } from '../consts';
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`关于我 | ${SITE_TITLE}`} description="关于 Oddyti 和他的小站">
	<aside class="about-card">
		<Image class="avatar pixel-avatar" src={avatar} alt="Oddyti" width={256} height={256} />
		<span class="name">{AUTHOR_NAME}</span>
		<span class="subtitle">{SITE_SUBTITLE}</span>
		<SocialLinks size={24} />
	</aside>

	<article class="about prose">		<h1>关于我</h1>

		<p><em>====苦逼读研中====</em></p>

		<p>
			INFP，虽然认为 MBTI 并不能决定一个人，但是可以给陌生的你我一个大致的印象。
		</p>

		<p>
			十几岁时给自己取了个网名叫 Oddyti，来源于 David Bowie 的 Space Oddity。我喜欢歌里漂浮的疏离感，于是就用 Oddyti 做了网名，并调换了 i 和 y，在那时的我看来，这是一个了不起的小巧思，现在看来也是。
		</p>

		<p><strong>我得活着</strong>，于是，我学了些信息技术。</p>

		<p>
			<strong>我想探索</strong>，我像个掰玉米的猴子，一个个爱好堆成了玉米堆，却仍然还在往前跑。
		</p>

		<p>
			<strong>我要保持胡思乱想</strong>，我偶尔停下来，挑一两只玉米填饱肚子，然后进入胡思乱想的梦。
		</p>
	</article>
</BaseLayout>

<style>
	.about-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		margin-bottom: 2rem;
		text-align: left;
	}

	.avatar {
		width: 64px;
		height: 64px;
	}

	.name {
		font-family: var(--font-pixel);
		font-size: var(--fs-lg);
		letter-spacing: 0.18em;
		text-shadow: var(--pixel-text-shadow);
	}

	.subtitle {
		font-size: var(--fs-md);
		color: var(--text-soft);
		line-height: 1.6;
	}

	.about-card :global(.social) {
		margin-top: 0.5rem;
	}
</style>